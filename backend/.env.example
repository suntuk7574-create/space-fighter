# Salin file ini menjadi .env lalu sesuaikan password/user Anda.
# Target utama (sesuai tugas): PostgreSQL
# Driver pg8000 dipilih karena murni Python (tidak butuh DLL/C++ Build Tools).
DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/spacefighter

# Untuk deploy cloud, URL dari Neon boleh langsung dipaste apa adanya:
# DATABASE_URL=postgresql://user:pass@host.neon.tech/db?sslmode=require
# Aplikasi otomatis menerjemahkan sslmode ke ssl_context pg8000, jadi jangan
# mengubah query string-nya manual.

# Isi hanya jika frontend di-host di domain BERBEDA dari backend.
# Kalau frontend disajikan oleh FastAPI (satu URL), biarkan kosong.
# FRONTEND_ORIGIN=https://game-kamu.onrender.com

# Akun admin tunggal (ganti password & secret sebelum deploy!)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
# ADMIN_DISPLAY_NAME=Administrator
# ADMIN_SECRET=ganti-dengan-string-acak-panjang

# Alternatif MySQL/MariaDB (tambahkan pymysql ke requirements.txt):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/spacefighter
# DATABASE_URL=mariadb+mariadbconnector://root:password@localhost:3306/spacefighter
