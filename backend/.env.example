# Salin file ini menjadi .env lalu sesuaikan password/user Anda.
# Target utama (sesuai tugas): PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/spacefighter

# Untuk deploy cloud, tambahkan ?sslmode=require pada URL Postgres, misalnya:
# DATABASE_URL=postgresql+psycopg://user:pass@host.neon.tech/db?sslmode=require

# Isi hanya jika frontend di-host di domain BERBEDA dari backend.
# Kalau frontend disajikan oleh FastAPI (satu URL), biarkan kosong.
# FRONTEND_ORIGIN=https://game-kamu.onrender.com

# Alternatif MySQL/MariaDB (tambahkan pymysql ke requirements.txt):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/spacefighter
# DATABASE_URL=mariadb+mariadbconnector://root:password@localhost:3306/spacefighter
